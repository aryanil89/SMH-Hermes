# Secrets
.env
.env.*
!.env.example
!.env_boards.example
*token*
*.pem
*.key
credentials*
telegram_info

# IP strategy material — internal analysis, never publish.
docs/IP_ASSESSMENT*

# Local AI-tool settings (Claude Code) — per-machine permission state, never shared.
.claude/

# Runtime output — the UNO Q push pipeline appends to this continuously while the
# board is up. Tracking it kept the working tree permanently dirty; every reader
# degrades to labeled mock data when it is absent or stale, so a clone without it
# behaves correctly.
/arduino_uno_q-sensor_log.json

# Qualcomm-internal material — must NOT reach a public repo.
# The hackathon deck is marked "Confidential - Qualcomm Technologies, Inc. ... May Contain Trade
# Secrets" and slide 16 carries event WiFi + laptop credentials. Cite it in docs; don't commit it.
docs/*.pdf
*Internal*.pdf

# Biometrics and captured images — never commit, not even once.
# The access sentry captures faces of real people. Enrolment keeps only float
# embeddings (mcp-tools/.state/roster.json) and deletes the source image, but a
# capture is briefly on disk and a stray `git add -A` must not publish it.
# This block exists BEFORE the first photo does, on purpose.
mcp-tools/.state/
captures/
roster.json
*.jpg
*.jpeg
*.png
*.webp
!docs/**/*.png

# Node
node_modules/
dist/
build/
*.log
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# On-device activity-inference runtime (llama.cpp binaries + GGUF model,
# fetched by uno-q/hermes-sensor-logger/scripts/fetch_llm_runtime.sh) --
# large, device-specific, rebuildable. Same reasoning as the face-cpu ONNX
# models below.
uno-q/hermes-sensor-logger/runtime/

# NPU / model build artifacts (large, device-specific, rebuildable)
*.bin
*.dlc
*.pte
*.onnx
*.gguf
bundles/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local settings (machine-specific, not shared)
.claude/settings.local.json

# Benchmark evidence — keep these LAST so they override earlier ignores.
# bench/artifacts/ holds the §3 per-op profiling outputs (QAIRT Visualizer
# inputs); its token_ar1 dir names collide with *token* above, and its
# qnn-profiling-data_0.log files with *.log. llm-serving-bench serve logs
# are the §1 crash evidence RESULTS.md cites.
!bench/artifacts/
!bench/artifacts/**
!llm-serving-bench/**/*.log
