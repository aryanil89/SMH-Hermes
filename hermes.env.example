# Template for Hermes Agent's own .env — NOT a repo .env.
#
#   Copy to:  %LOCALAPPDATA%\hermes\.env        (this is HERMES_HOME on a native
#                                                Windows install; there is no ~/.hermes)
#
# Hermes ships a large stock .env full of commented-out cloud-provider keys. You do NOT
# need any of them: the model is served locally by GenieX. Only the four settings below
# matter for this project — the rest are optional knobs for the ack hook. Leave everything
# else in the stock file untouched.

# ---------------------------------------------------------------------------
# Telegram — the phone channel (the one cloud hop in the system)
# ---------------------------------------------------------------------------
# Bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456789:AA-replace-me

# Comma-separated numeric Telegram user IDs allowed to talk to the bot.
# Get yours by messaging @userinfobot. Without this, anyone who finds the bot can use it.
TELEGRAM_ALLOWED_USERS=123456789

# Where Hermes pushes messages you did not ask for (cron alerts). Same numeric id.
# Equivalent to running /sethome in the chat once.
TELEGRAM_HOME_CHANNEL=123456789

# NOTE: the repo-side services (15s watchdog, wall display, access notifications,
# scripts/) do NOT read this file — they take TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID
# (same numeric id as TELEGRAM_HOME_CHANNEL) from the Windows environment, so the
# Scheduled Tasks inherit them. Set them once as user env vars:
#   setx TELEGRAM_BOT_TOKEN 123456789:AA-replace-me
#   setx TELEGRAM_CHAT_ID   123456789

# ---------------------------------------------------------------------------
# GenieX compatibility — REQUIRED, and easy to lose
# ---------------------------------------------------------------------------
# GenieX's streaming responses end without a finish_reason/tool-call frame, so Hermes
# treats every completed reply as a mid-stream drop and retries forever. This flag forces
# non-streaming calls, which GenieX handles correctly.
#
# It only takes effect together with the local patch in
#   %LOCALAPPDATA%\hermes\hermes-agent\agent\conversation_loop.py
# Verify the patch is present:
#   Select-String -Path "$env:LOCALAPPDATA\hermes\hermes-agent\agent\conversation_loop.py" -Pattern HERMES_FORCE_NONSTREAM
#
# WARNING: `hermes update` reverts that patch. Do not run it mid-event.
HERMES_FORCE_NONSTREAM=1

# ---------------------------------------------------------------------------
# Message receipts — the ack hook (all optional; defaults are the demo config)
# ---------------------------------------------------------------------------
# A turn takes 60-300s and non-streaming mode means the phone sees nothing until it
# lands. The ack hook replies within ~2s with a one-line receipt written by the local
# model. Install it with scripts\install-hermes-hooks.ps1; details and limits in
# hermes-hooks/README.md.
#
# Nothing below needs setting to use it. The endpoint and model default to whatever
# model.base_url / model.default say in config.yaml, so the receipt cannot drift onto a
# different model than the agent is using.

# 0 turns receipts off without uninstalling the hook. Takes effect at gateway restart.
#HERMES_ACK_ENABLED=1

# Hard ceiling on how long a receipt may delay the turn it announces. The receipt is
# generated BEFORE the agent's first model call on purpose — GenieX serializes requests,
# so a receipt generated afterwards would queue behind the whole turn. Past this many
# seconds it goes out canned instead. Measured warm cost: ~2.3s.
#HERMES_ACK_TIMEOUT_S=12

# Override only to point receipts at a different server than the agent uses.
#HERMES_ACK_BASE_URL=http://127.0.0.1:18181/v1
#HERMES_ACK_MODEL=unsloth/Qwen3-4B-Instruct-2507-GGUF:Q4_0

# ---------------------------------------------------------------------------
# Phone-NPU failover — the failover hook (all optional; defaults are the demo config)
# ---------------------------------------------------------------------------
# When a TCP connect to GenieX's port is REFUSED (process dead — not merely busy;
# a busy server still accepts TCP), the failover hook answers the question on the
# S25 Ultra's Snapdragon 8 Elite NPU over adb instead: one-shot genie-t2t-run, no
# tools, labeled as degraded, delivered to Telegram and the wall. Install with
# scripts\install-hermes-hooks.ps1; details and limits in hermes-hooks/README.md.
#
# Phone prerequisites (demo dependencies, not defaults): the Genie bundle staged
# at /data/local/tmp/hermes-npu-bench, USB debugging ON, Samsung Auto Blocker OFF.
# scripts\demo-failover-ON.ps1 preflights all three.

# 0 disarms the hook without uninstalling it. Takes effect at gateway restart.
#HERMES_FAILOVER=1

# adb binary. Default: the winget scrcpy adb if present, else adb from PATH.
#HERMES_FAILOVER_ADB=C:\path\to\adb.exe

# adb serial of the phone. Default: auto-detected. Only needed if adb reports
# several usable devices AND more than one carries the genie bundle — the UNO Q
# sensor board is an adb device too, so the demo runs with two attached and adb
# will not choose between them on its own (`adb devices` lists the serials).
#HERMES_FAILOVER_SERIAL=R3CXC07ZXZB

# Ceiling in seconds on the phone answer (prompt push + genie run). Measured warm
# round-trip: ~10s. Past the ceiling an honest failure line is sent instead.
#HERMES_FAILOVER_TIMEOUT=90

# Probe target override as host:port. Default: model.base_url from config.yaml,
# else 127.0.0.1:18181 — same server the agent itself uses.
#HERMES_FAILOVER_PROBE=127.0.0.1:18181
